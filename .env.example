# ── Required in production ──
APP_SECRET=change-me-to-a-long-random-string   # encrypts stored API keys + signs admin sessions
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me                       # or ADMIN_PASSWORD_HASH=<bcrypt hash>
# COOKIE_SECURE=true                           # when served over HTTPS

# ── Optional: keys can also be added later in /admin (stored encrypted, never public) ──
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
GEMINI_API_KEY=          # Veo 3.1 first→last frame (set VIDEO_PROVIDER=veo in admin)
ELEVENLABS_API_KEY=
XAI_API_KEY=
YOUTUBE_API_KEY=

# ── Runtime ──
DATA_DIR=./data
# CHROMIUM_PATH=/path/to/chrome   # for the research desktop if Playwright's browser is elsewhere
