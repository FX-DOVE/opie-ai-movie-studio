<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout><font place="ActiveWindow"><name>DejaVu Sans</name><size>10</size></font></theme>
  <keyboard><keybind key="W-d"><action name="ToggleShowDesktop"/></keybind><keybind key="A-F4"><action name="Close"/></keybind></keyboard>
  <desktops><number>1</number></desktops>
  <applications><application class="*"><decor>yes</decor></application>
    <application class="Chromium*"><maximized>yes</maximized></application>
    <application class="Google-chrome"><maximized>yes</maximized></application></applications>
  <margins><top>0</top><bottom>30</bottom></margins>
</openbox_config>
